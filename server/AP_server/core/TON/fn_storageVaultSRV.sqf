/*
    APS_fnc_storageVaultSRV  (LooneyBin, owner 2026-07-11)
    THE STORAGE WORKER -- a player-owned, DB-backed holding vault used to move a whole house's storage out
    of the property (for a fee) and later unpack it into a DIFFERENT house. You CANNOT browse the vault --
    it is a transfer buffer only (house -> slot, slot -> house). Also the intended cross-map migration point
    (one portable per-UID table).

    Modes (client -> server, remoteExec allowedTargets=2), all reply to the CALLER via AP_fnc_storageVaultRecv:
        ["list",   _player]                 -> [_slots, _houses, ""]                 refresh both panels
        ["pack",   _player, _oid]           -> empty that house's storage into a NEW vault slot
        ["unpack", _player, _slotId, _oid]  -> partial-fill that house from the slot (rest stays in vault)

    DATA MODEL
        storage_vault(slot_id PK, uid, label, src_class, vinv, pinv, weight, created_at) -- one row per PACK.
        House storage is the SAME [[items],weight] mres pair the trunk uses (vinv=virtual, pinv=physical gear).

    DUPE SAFETY (the whole reason this is server-side + object-gated)
      * pack/unpack RESOLVE the house object and REFUSE if it is currently OPEN (AP_invHydrated). A stale
        trunk-close writing the pre-pack inventory back would leave items in BOTH the slot and the house.
      * after a pack, the object is emptied GLOBAL + server-local, dehydrated, and its AP_invGen bumped, so any
        in-flight close no-ops (the fn_updateHouseTrunk gen guard) -- belt and suspenders.
      * unpack writes a NOT-open house, so there is no live session to clobber; the next gated hydrate reads
        the fresh DB row.
      * money is charged CLIENT-side (AP_atmcash, the codebase purchase idiom) -- the fee is a sink, not a
        gain, so it isn't a dupe/integrity vector; the server only verifies OWNERSHIP (anti-grief) + does the
        authoritative item move.
*/
params [["_mode", "", [""]], ["_player", objNull, [objNull]], ["_a2", "", ["", 0]], ["_a3", "", ["", 0]]];
if (!isServer) exitWith {};
private _owner = remoteExecutedOwner;   // 0 = server-internal; else the caller's client id (reply target)

// caller resolution + non-spoofable actor (mirror fn_updateHouseTrunk)
if (_owner isNotEqualTo 0) then { _player = (allPlayers select { owner _x isEqualTo _owner }) param [0, objNull]; };
if (isNull _player) exitWith {};
private _uid = getPlayerUID _player;
if (_uid isEqualTo "") exitWith {};

#define VAULT_LABEL_MAX 96
#define VAULT_RATE      10        // $ per unit of stored weight to pack a house (mirror in AP_fnc_storageVault)

// ── one-time table ensure (self-healing on any box incl. a fresh cross-map target) ────────────
// mode 2 (waits for completion), NOT the default fire-and-forget: on the very first vault open of a fresh
// DB the follow-up slots SELECT raced the async CREATE and threw MariaDBQueryException (live b0153, 01:26).
if (isNil "AP_vaultTableReady") then {[format ["CREATE TABLE IF NOT EXISTS storage_vault ("
        + "slot_id integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, "
        + "uid varchar(17) NOT NULL, "
        + "label varchar(%1) NOT NULL DEFAULT '', "
        + "src_class varchar(64) NOT NULL DEFAULT '', "
        + "vinv text, "
        + "pinv text, "
        + "weight integer NOT NULL DEFAULT 0, "
        + "created_at timestamptz NOT NULL DEFAULT now())", VAULT_LABEL_MAX], 2] call DB_fnc_asyncQuery;
    ["CREATE INDEX IF NOT EXISTS storage_vault_uid ON storage_vault (uid)", 2] call DB_fnc_asyncQuery;   // inline INDEX is MySQL-only
    AP_vaultTableReady = true;};

// ── shared helpers ────────────────────────────────────────────────────────────────────────────
// decode a mres text column -> array (the fn_receiveHouses / fn_initHouseInventory idiom).
private _dec = {params [["_s", "", [""]]];
    if (isNil "_s" || {_s isEqualTo ""} || {_s isEqualTo "NULL"}) exitWith { [] };
    private _arr = [_s] call DB_fnc_mresToArray;
    if (typeName _arr == "STRING") then { _arr = parseSimpleArray (format ["%1", _arr]); };
    if (isNil "_arr") then { _arr = []; };
    _arr};
// [[items],weight] normaliser (a NULL/empty column decodes to [] -> treat as the empty pair)
private _pair = { params ["_v"]; if (_v isEqualType [] && {count _v >= 2} && {(_v select 0) isEqualType []}) then { _v } else { [[], 0] } };
// mres-encode + SQL-escape one storage pair for a write
private _enc = { params ["_v"]; (([_v] call DB_fnc_mresArray) splitString "'") joinString "''" };
// SQL-escape a bare string
private _esc = { params ["_s"]; ((format ["%1", _s]) splitString "'") joinString "''" };

// parse a houses.worldspace column -> [x,y,z]. Stored as plain str(getPosATL) text (fn_CLinitHouses
// parseSimpleArray idiom) and read QUOTE()'d, so it arrives here as the raw "[x,y,z]" string.
private _wsPos = {params ["_ws"];
    private _s = format ["%1", _ws];
    if ((_s select [0, 1]) isNotEqualTo "[") exitWith { [0,0,0] };
    private _t = parseSimpleArray _s;
    if (isNil "_t" || {!(_t isEqualType [])} || {_t isEqualTo []}) exitWith { [0,0,0] };
    if ((_t param [0, 0]) isEqualType []) then { _t param [0, [0,0,0]] } else { _t };};
// resolve a house's live building object from its stored pos + oid (shed-aware, mirrors fn_tagHousesSRV).
// returns objNull if it can't be found -> caller ABORTS rather than risk an un-gated write.
private _resolveHouse = {params ["_pos", "_oid", "_cls"];
    // hidden objects are never legit targets (a maldened house's IMMOVABLE hidden original stands 0.2m
    // from its visible Argo shell -- big terrain houses refuse setPosASL; the shell carries the identity)
    private _cands = (nearestObjects [_pos, ["House_F"], 14]) select { !isObjectHidden _x };
    private _b = objNull;
    if (_cls isEqualTo "Land_i_Shed_Ind_F" || {_cls isEqualTo "Land_u_Shed_Ind_F"} || {(nearestObjects [_pos, ["Land_i_Shed_Ind_F"], 18]) isNotEqualTo []}) then {
        _b = (nearestObjects [_pos, ["Land_i_Shed_Ind_F"], 18]) param [0, objNull];} else {
        if (_cls isNotEqualTo "" && {_cls isNotEqualTo "NULL"}) then { _b = (_cands select { (typeOf _x) isEqualTo _cls }) param [0, objNull]; };
        if (isNull _b) then { _b = (_cands select { (format ["%1", _x getVariable ["AP_houseID", -1]]) isEqualTo (format ["%1", _oid]) }) param [0, objNull]; };
        if (isNull _b) then { _b = _cands param [0, objNull]; };};
    _b};
// friendly town label for a position (best-effort; client also prettifies the class)
private _townOf = {params ["_pos"];
    private _loc = locationNull;
    { if (isNull _loc) then { _loc = nearestLocation [_pos, _x]; }; } forEach ["NameCityCapital", "NameCity", "NameVillage", "NameLocal"];
    if (!isNull _loc) then { text _loc } else { mapGridPosition _pos }};

// build the two panels for the caller and push them (with a status line + optional charge) back to that
// client. _charge > 0 (only on a successful PACK) tells the client to deduct the fee NOW -- charging
// server-confirmed avoids taking money on a refused pack (house open / not owner / empty).
private _fnSendState = {params [["_status", "", [""]], ["_charge", 0]];
    // -- vault slots -- (QUOTE every plain-text col -- the b0126 bareword lesson; multi-row flag REQUIRED:
    // without the 3rd `true`, asyncQuery mode 2 returns the FIRST ROW FLAT and each column renders as a row)
    private _rows = [format ["SELECT slot_id, COALESCE(label,'') AS label, COALESCE(src_class,'') AS src_class, weight FROM storage_vault WHERE uid='%1' ORDER BY slot_id", [_uid] call _esc], 2, true] call DB_fnc_asyncQuery;
    if (isNil "_rows" || {!(_rows isEqualType [])}) then { _rows = []; };
    private _slots = _rows apply {_x params [["_sid", 0], ["_lab", ""], ["_sc", ""], ["_wt", 0]];
        [parseNumber (format ["%1", _sid]), format ["%1", _lab], format ["%1", _sc], parseNumber (format ["%1", _wt]), ""]};
    // -- owned houses [oid, class, town, virtualWt, physWt, vcap, phys_cap, customName] --
    private _hr = [format ["SELECT oid, worldspace, vcap, phys_cap, vinv, pinv, COALESCE(classname,'') AS classname, COALESCE(custom_name,'') AS custom_name FROM houses WHERE owners='%1'", [_uid] call _esc], 2, true] call DB_fnc_asyncQuery;
    if (isNil "_hr" || {!(_hr isEqualType [])}) then { _hr = []; };
    private _houses = _hr apply {
        _x params [["_oid", ""], ["_ws", ""], ["_vc", 0], ["_pc", 0], ["_v", ""], ["_p", ""], ["_cls", ""], ["_cname", ""]];
        private _vP = [[_v] call _dec] call _pair;
        private _pP = [[_p] call _dec] call _pair;
        private _pos = [_ws] call _wsPos;
        [format ["%1", _oid], format ["%1", _cls], [_pos] call _townOf, (_vP param [1, 0]) max 0, (_pP param [1, 0]) max 0,
            parseNumber (format ["%1", _vc]), parseNumber (format ["%1", _pc]), format ["%1", _cname]]};
    [[_slots, _houses, _status, _charge], "AP_fnc_storageVaultRecv", _owner] call AP_fnc_MP;};

// find one owned house row by oid -> [oid, worldspace, vcap, phys_cap, vinv, pinv, classname, custom_name].
// Ownership enforced in the WHERE (a selected bare 17-digit owners col loses float precision -> never compare
// Steam64s read bare); returns [] if the row isn't the caller's.
private _fnOwnedRow = {params ["_oid"];
    private _r = [format ["SELECT oid, worldspace, vcap, phys_cap, vinv, pinv, COALESCE(classname,'') AS classname, COALESCE(custom_name,'') AS custom_name FROM houses WHERE oid='%1' AND owners='%2'", [_oid] call _esc, [_uid] call _esc], 2] call DB_fnc_asyncQuery;
    if (isNil "_r" || {!(_r isEqualType [])}) exitWith { [] };
    _r};

// ── LIST ──────────────────────────────────────────────────────────────────────────────────────
if (_mode isEqualTo "list") exitWith { [""] call _fnSendState; };

// ── PACK: empty a house's storage into a fresh vault slot ───────────────────────────────────────
if (_mode isEqualTo "pack") exitWith {private _oid = format ["%1", _a2];
    private _row = [_oid] call _fnOwnedRow;
    if (_row isEqualTo []) exitWith {["-VAULT-", _player, format ["pack DENIED (not owner) oid %1 by %2", _oid, _uid]] call APS_fnc_logIt;
        ["You do not own that property."] call _fnSendState;};
    _row params ["", "_ws", "", "", "_vRaw", "_pRaw", "_cls", "_cname"];
    private _vP = [[_vRaw] call _dec] call _pair;
    private _pP = [[_pRaw] call _dec] call _pair;
    private _wt = ((_vP param [1, 0]) + (_pP param [1, 0])) max 0;
    if (((_vP param [0, []]) isEqualTo []) && {(_pP param [0, []]) isEqualTo []}) exitWith {
        ["That property's storage is already empty."] call _fnSendState;};
    // resolve the building + refuse if it's currently OPEN (dupe guard)
    private _house = [[_ws] call _wsPos, _oid, format ["%1", _cls]] call _resolveHouse;
    if (isNull _house) exitWith {["-VAULT-", _player, format ["pack ABORT (unresolved building) oid %1", _oid]] call APS_fnc_logIt;
        ["Could not locate that property right now. Try again in a moment."] call _fnSendState;};
    if (_house getVariable ["AP_invHydrated", false]) exitWith {
        ["Someone has that property's storage open. Close it first."] call _fnSendState;};
    // 1) stash into a new slot. Label = the player-set house name (custom_name) when there is one, else the
    //    town -- so the vault list reads like the player's own property list. Truncate BEFORE SQL-escaping
    //    (cutting after escape could split a '' pair and break the INSERT). src_class kept for the type label.
    private _cn = format ["%1", _cname];
    private _labelDisp = if (_cn isNotEqualTo "" && {_cn isNotEqualTo "NULL"}) then { _cn } else { format ["%1", [[_ws] call _wsPos] call _townOf] };
    if (count _labelDisp > VAULT_LABEL_MAX) then { _labelDisp = _labelDisp select [0, VAULT_LABEL_MAX]; };
    private _label = [_labelDisp] call _esc;
    [format ["INSERT INTO storage_vault (uid,label,src_class,vinv,pinv,weight) VALUES ('%1','%2','%3','%4','%5',%6)",
        [_uid] call _esc, _label, [format ["%1", _cls]] call _esc, [_vP] call _enc, [_pP] call _enc, round _wt]] call DB_fnc_asyncQuery;
    // 2) empty the house: DB row + object (global empty, server-local empty, dehydrate, gen-bump)
    [format ["UPDATE houses SET vinv='%1', pinv='%2' WHERE oid='%3'", [ [[], 0] ] call _enc, [ [[], 0] ] call _enc, [_oid] call _esc]] call DB_fnc_asyncQuery;
    _house setVariable ["AP_invHydrated", false, true];
    _house setVariable ["AP_vinv", [[], 0], true];
    _house setVariable ["AP_pinv", [[], 0], true];
    _house setVariable ["AP_vinv", [[], 0]];
    _house setVariable ["AP_pinv", [[], 0]];
    _house setVariable ["AP_invGen", (_house getVariable ["AP_invGen", 0]) + 1, true];
    private _fee = round (_wt * VAULT_RATE);
    ["-VAULT-", _player, format ["PACK oid %1 (%2 wt, $%3) -> vault by %4", _oid, round _wt, _fee, _uid]] call APS_fnc_logIt;
    uiSleep 0.3;   // let the async INSERT + empty-UPDATE land before the refresh SELECT (read-after-write)
    [format ["Packed up %1 (%2 wt) into the vault.", _labelDisp, round _wt], _fee] call _fnSendState;};

// ── UNPACK: partial-fill a house from a slot; overflow stays in the slot ────────────────────────
if (_mode isEqualTo "unpack") exitWith {private _slotId = parseNumber (format ["%1", _a2]);
    private _oid    = format ["%1", _a3];
    // slot must belong to the caller -- ownership in the WHERE (a bare-read uid col loses Steam64 precision)
    private _sr = [format ["SELECT vinv,pinv FROM storage_vault WHERE slot_id=%1 AND uid='%2'", _slotId, [_uid] call _esc], 2] call DB_fnc_asyncQuery;
    if (isNil "_sr" || {!(_sr isEqualType [])} || {_sr isEqualTo []}) exitWith {
        ["-VAULT-", _player, format ["unpack DENIED (slot %1 not owner) by %2", _slotId, _uid]] call APS_fnc_logIt;
        ["That vault slot isn't yours."] call _fnSendState;};
    private _svP = [[_sr select 0] call _dec] call _pair;
    private _spP = [[_sr select 1] call _dec] call _pair;
    // target house must be owned by caller
    private _row = [_oid] call _fnOwnedRow;
    if (_row isEqualTo []) exitWith { ["You do not own that destination property."] call _fnSendState; };
    _row params ["", "_ws", "_vcapR", "_pcapR", "_vRaw", "_pRaw", "_cls"];
    private _vcap = parseNumber (format ["%1", _vcapR]);
    private _pcap = parseNumber (format ["%1", _pcapR]);
    private _house = [[_ws] call _wsPos, _oid, format ["%1", _cls]] call _resolveHouse;
    if (isNull _house) exitWith { ["Could not locate that property right now. Try again in a moment."] call _fnSendState; };
    if (_house getVariable ["AP_invHydrated", false]) exitWith { ["Someone has that property's storage open. Close it first."] call _fnSendState; };
    private _dvP = [[_vRaw] call _dec] call _pair;   // destination current virtual
    private _dpP = [[_pRaw] call _dec] call _pair;   // destination current physical

    // per-unit weight oracles (guarded -- unknown weight counts as 0 so it always fits, matching the
    // permissive updateHouseTrunk stance; the cap is the only limiter and a nil oracle must not lose gear).
    private _uwVirt = { params ["_cn"]; if (isNil "AP_fnc_virtItemCfg") exitWith { 0 }; private _w = ["getItemWeight", _cn] call AP_fnc_virtItemCfg; if (_w isEqualType 0) then { _w } else { 0 } };
    private _uwPhys = { params ["_cn"]; if (isNil "AP_fnc_physicalInventoryWeight") exitWith { 0 }; private _w = [[_cn, 1]] call AP_fnc_physicalInventoryWeight; if (_w isEqualType 0) then { _w } else { 0 } };

    // greedy partial fill of ONE column: move whole/partial stacks from src into dst while under cap;
    // return [newDstItems, leftoverSrcItems, moved?].
    private _fill = {params ["_srcItems", "_dstItems", "_cap", "_uwFn"];
        private _dst = +_dstItems;
        // current dst weight from its items (authoritative, don't trust the stored scalar)
        private _used = 0; { _used = _used + (([_x select 0] call _uwFn) * (_x select 1)); } forEach _dst;
        private _room = (_cap - _used) max 0;
        private _left = [];
        private _moved = false; {_x params ["_cn", "_qty"];
            private _uw = [_cn] call _uwFn;
            private _canUnits = if (_uw <= 0) then { _qty } else { floor (_room / _uw) };
            private _move = (_qty min _canUnits) max 0;
            if (_move > 0) then {private _idx = _dst findIf { (_x select 0) isEqualTo _cn };
                if (_idx > -1) then { (_dst select _idx) set [1, (_dst select _idx select 1) + _move]; } else { _dst pushBack [_cn, _move]; };
                _room = _room - (_move * _uw);
                _moved = true;};
            if ((_qty - _move) > 0) then { _left pushBack [_cn, _qty - _move]; };} forEach _srcItems;
        [_dst, _left, _moved]};
    // recompute a column's [[items],weight] pair from items + oracle
    private _repair = { params ["_items", "_uwFn"]; private _w = 0; { _w = _w + (([_x select 0] call _uwFn) * (_x select 1)); } forEach _items; [_items, _w] };

    ([_svP param [0, []], _dvP param [0, []], _vcap, _uwVirt] call _fill) params ["_newDV", "_leftV", "_mv"];
    ([_spP param [0, []], _dpP param [0, []], _pcap, _uwPhys] call _fill) params ["_newDP", "_leftP", "_mp"];
    if (!_mv && {!_mp}) exitWith { ["No room in that property for any of this slot's contents."] call _fnSendState; };

    private _dstV = [_newDV, _uwVirt] call _repair;
    private _dstP = [_newDP, _uwPhys] call _repair;
    private _remV = [_leftV, _uwVirt] call _repair;
    private _remP = [_leftP, _uwPhys] call _repair;

    // write the destination house (not open -> DB + server-local; next hydrate broadcasts it)
    [format ["UPDATE houses SET vinv='%1', pinv='%2' WHERE oid='%3'", [_dstV] call _enc, [_dstP] call _enc, [_oid] call _esc]] call DB_fnc_asyncQuery;
    _house setVariable ["AP_vinv", _dstV];
    _house setVariable ["AP_pinv", _dstP];

    // slot: fully drained -> delete; else update with the leftover
    private _slotEmpty = ((_leftV isEqualTo []) && {_leftP isEqualTo []});
    if (_slotEmpty) then {[format ["DELETE FROM storage_vault WHERE slot_id=%1", _slotId]] call DB_fnc_asyncQuery;} else {
        private _rw = round ((_remV param [1, 0]) + (_remP param [1, 0]));
        [format ["UPDATE storage_vault SET vinv='%1', pinv='%2', weight=%3 WHERE slot_id=%4", [_remV] call _enc, [_remP] call _enc, _rw, _slotId]] call DB_fnc_asyncQuery;
    };
    ["-VAULT-", _player, format ["UNPACK slot %1 -> oid %2 (leftover %3) by %4", _slotId, _oid, !_slotEmpty, _uid]] call APS_fnc_logIt;
    private _msg = if (_slotEmpty) then { "Unpacked the whole slot into your property." } else { "Unpacked what fit. The rest stays in the vault for another property." };
    uiSleep 0.3;   // let the async house-UPDATE + slot UPDATE/DELETE land before the refresh SELECT
    [_msg] call _fnSendState;};

// unknown mode
[""] call _fnSendState;
