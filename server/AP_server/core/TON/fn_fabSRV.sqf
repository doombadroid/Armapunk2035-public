/*
    APS_fnc_fabSRV  (Armapunk -- 3D printer / Fabricator, server-authoritative. spec: the fab plan)

    Production costs MATERIALS AND TIME, never money. The only currency in this feature is the
    price of a schematic, in New Drachma, and that lives in APS_fnc_fabGrantSRV -- not here.

        ["ensure",  []]                                          -- idempotent DDL, first touch
        ["reload",  []]                                          -- boot: respawn placed printers
        ["list",    [player, house]]                             -- push this house's printers
        ["place",   [player, house, tier, posATL, dir]]          -- install (client consumed the item)
        ["pickup",  [player, printerId]]                         -- uninstall, refund the item
        ["queue",   [player, printerId, recipeKey, qty]]         -- start a job (client consumed parts)
        ["collect", [player, printerId]]                         -- take finished output

    ---------------------------------------------------------------------------------------------
    THE CLOCK IS THE DATABASE'S. finish_at is an absolute epoch written as
    `extract(epoch from now())::bigint + <seconds>`, and "is it done" is
    `GREATEST(finish_at - extract(epoch from now())::bigint, 0)`. This is the qhSRV rule
    (fn_qhSRV.sqf:50-52) and the drone_recharge_until shape, NOT the greenhouse's
    AP_bootUnix + serverTime. The greenhouse pays an epoch-offset tax (AP_GH_EPOCH = 1.7e9) because
    SQF floats have a ~128 s ULP at raw unix and its growth curve is sampled continuously; a print
    job only ever asks "past the deadline or not", so letting PostgreSQL answer costs nothing and
    removes the offset, the JIP publicVariable and every toFixed along with it.

    A JOB RUNS WHILE THE OWNER IS OFFLINE. Nothing sweeps: readiness is computed when someone
    scrolls the machine, the same lazy evaluation the greenhouse and the mining rig use. There is
    no queue table and no callback.

    ---------------------------------------------------------------------------------------------
    ROWS, NOT A COLUMN ON `houses`. The obvious shape is a houses.printers blob next to
    greenhouse_crop and barrel_crop. It is the wrong one: the mining rig started exactly there
    (houses.miner varchar(48)) and that column IS what caused its collect dupe -- a malformed write
    overflowed the varchar, the UPDATE was rejected, asyncQuery reported the rejection as [] just
    like a success, the timestamp froze and every later collect re-minted the full accrual on 10 of
    13 live rigs (BUGS.md #555). The rewrite moved to house_rigs and both columns are dead. This
    copies the destination.

    COLLECT IS FAIL-CLOSED IN THREE LAYERS, straight from that post-mortem:
      1. a per-printer in-flight lock, so two collects cannot interleave;
      2. a BLOCKING (mode 2) update that clears the job before the lock is released;
      3. a re-SELECT proving the row actually cleared before a single item is granted.
    asyncQuery cannot distinguish a successful write from a rejected one -- both return [] -- so
    step 3 is the only thing standing between a failed UPDATE and an infinite item printer. A
    withheld legitimate collect just retries on the next scroll; that asymmetry is deliberate.
*/
params [["_case", "", [""]], ["_data", [], [[]]]];
if (!isServer) exitWith {};
// owner 2026-09-26 SECURITY (houses review): the acting player (every case's first datum) is whoever remoteExec'd
// this, never the payload's -- a client naming someone else got that player's access and their deliveries.
if (isRemoteExecuted && {_data isNotEqualTo []}) then { _data set [0, (allPlayers select { owner _x isEqualTo remoteExecutedOwner }) param [0, objNull]]; };

// FIVE PER PLAYER, TOTAL, whatever the mix -- printers and benches count against one number, and
// it does not matter how many houses they are spread across. Same shape as the mining rig's
// MINE_MAX_RIGS, and for the same reason: a per-HOUSE cap is really a cap on how many houses you
// own, which is a different game. Counted on the `owner` column, which holds the installer.
#define FAB_MAX_PER_PLAYER 5

// ---------------------------------------------------------------- schema (self-healing, blocking)
// mode 2 on purpose: on the first touch of a fresh DB an async CREATE races the follow-up SELECT,
// which is the lesson written into fn_storageVaultSRV.sqf:41-53. Inline INDEX is MySQL-only.
private _ensure = {
    if (!isNil "AP_fabTableReady") exitWith {};
    ["CREATE TABLE IF NOT EXISTS house_printers (
        id bigint NOT NULL GENERATED BY DEFAULT AS IDENTITY,
        oid varchar(64) NOT NULL,
        owner varchar(32) NOT NULL,
        tier smallint NOT NULL DEFAULT 1,
        pos varchar(96) NOT NULL,
        CONSTRAINT house_printers_pkey PRIMARY KEY (id))", 2] call DB_fnc_asyncQuery;
    ["CREATE INDEX IF NOT EXISTS house_printers_idx_oid ON house_printers (oid)", 2] call DB_fnc_asyncQuery;

    // A JOB IS A ROW, not a column on the printer. The first cut put recipe/qty/finish_at on
    // house_printers, which silently capped every machine at one job -- while the tier table
    // advertised 3 slots for a CoreXY. Rows make the slot count real, and they keep the fail-closed
    // collect intact: each job is cleared and proved gone on its own, so one job's failure cannot
    // take another's grant with it. These three DROPs clean a dev database that ran the earlier
    // shape; IF EXISTS makes them a no-op everywhere else.
    ["ALTER TABLE house_printers DROP COLUMN IF EXISTS recipe", 2] call DB_fnc_asyncQuery;
    ["ALTER TABLE house_printers DROP COLUMN IF EXISTS qty", 2] call DB_fnc_asyncQuery;
    ["ALTER TABLE house_printers DROP COLUMN IF EXISTS finish_at", 2] call DB_fnc_asyncQuery;

    ["CREATE TABLE IF NOT EXISTS house_printer_jobs (
        id bigint NOT NULL GENERATED BY DEFAULT AS IDENTITY,
        printer_id bigint NOT NULL,
        recipe varchar(64) NOT NULL,
        qty integer NOT NULL DEFAULT 1,
        finish_at bigint NOT NULL DEFAULT 0,
        CONSTRAINT house_printer_jobs_pkey PRIMARY KEY (id))", 2] call DB_fnc_asyncQuery;
    ["CREATE INDEX IF NOT EXISTS house_printer_jobs_idx_printer ON house_printer_jobs (printer_id)", 2] call DB_fnc_asyncQuery;
    AP_fabTableReady = true;
};

// In-flight locks. Keys are NAMESPACED ("p<id>" / "j<id>") because printers and jobs are separate
// identity sequences: printer 5 and job 5 both exist, and a shared key space would let a pickup on
// one spuriously block a collect on the other -- rare, silent, and maddening to reproduce.
// SERVER-ONLY STATE, localNamespace (r2fab, the miningSRV APS_rigBusy rule): as missionNamespace globals one client
// publicVariable replaced them -- a forged empty lock map let two collects of one job both grant, and a forged anchor
// map pointed pickup's deleteVehicle at any object and blanked every other printer until restart.
if (isNil {localNamespace getVariable "APS_fabBusy"}) then { localNamespace setVariable ["APS_fabBusy", createHashMap]; };
if (isNil {localNamespace getVariable "APS_fabAnchors"}) then { localNamespace setVariable ["APS_fabAnchors", createHashMap]; };   // printerId -> anchor
private _busyMap = localNamespace getVariable "APS_fabBusy";   // live references: set/deleteAt write through
private _anchors = localNamespace getVariable "APS_fabAnchors";

// row-then-cell. `_rows param [0,""]` alone hands back the ROW, and writing a stringified row into
// a varchar is precisely how the mining rig corrupted its own state column.
private _cell = { params ["_rows"]; format ["%1", (_rows param [0, []]) param [0, ""]] };
private _num = { params ["_s"]; parseNumber format ["%1", _s] };   // parseNumber THROWS on a number

private _say = {
    params ["_p", "_msg"];
    [[_msg, "basic"], "AP_fnc_handleMessage", _p, false, false] spawn AP_fnc_MP;
};
private _give = {
    params ["_p", "_item", "_n"];
    [[true, _item, _n], "AP_fnc_handleInv", _p, false, false] spawn AP_fnc_MP;
};

// Buyable-shed spots hold two buildings at ~0 m -- the hidden derelict and the intact
// createVehicle'd shed, which is not reliably isKindOf House_F. Same resolver as the greenhouse's;
// attaching a printer to the hidden derelict would make it invisible to every menu.
private _resolveHouse = {
    params ["_pos"];
    private _c = (nearestObjects [_pos, ["House_F", "Land_i_Shed_Ind_F"], 12]) select { !isObjectHidden _x };
    private _s = _c select { (typeOf _x) isEqualTo "Land_i_Shed_Ind_F" };
    if (_s isNotEqualTo []) then { _s select 0 } else { _c param [0, objNull] }
};

// WHO MAY USE A HOUSE'S MACHINES: its owner, anyone holding keys, or -- if this house is the
// designated GANG HOUSE -- any member of that gang. The first two are the greenhouse's rule. The
// third is the owner's "houses + gang bases" call, and it needs no new mechanic: a gang leader
// already nominates one owned house as the gang house (AP_gangBuilding / APS_fnc_changeGangHouseSRV),
// so a printer standing in it is a gang printer.
//
// Deliberately NOT the Gang Fortress. That is a contested single-owner capture point, and
// production sitting on it would change hands mid-job.
//
// Everything is re-derived from the houses ROW (APS_fnc_houseRights), never from anything a client sent.
// owner 2026-09-26 SECURITY (houses review, TONd-0-0 class): this read AP_homeOwner / AP_house_keys /
// AP_house_gang off the building -- object vars any client can setVariable publicly, so a forged owner tag
// opened a victim's printers and collect handed their finished jobs to the forger.
private _mayUse = {
    params ["_p", "_h"];
    private _u = getPlayerUID _p;
    private _r = [_h] call APS_fnc_houseRights;
    if (_u isEqualTo "" || {(_r select 0) isEqualTo ""}) exitWith { false };
    if ((_r select 1) isEqualTo _u) exitWith { true };
    if (_u in (_r select 5)) exitWith { true };
    // Gang house: the gang whose gangs.house_pos is this row's building (APS_fnc_changeGangHouseSRV /
    // APS_fnc_addGangHouse store it when a leader nominates the house).
    //
    // The PLAYER side needs its own lookup: there is no server-side per-player gang variable anywhere in this
    // codebase -- the client holds AP_gang_data and the server reads players.gang0 when it needs to
    // know. So this reads gang0, and does it ONLY on the path where the first two checks already
    // failed AND the house is actually gang-tagged, which keeps a database round trip off the
    // common case entirely. Reading the client's copy instead would be the same mistake as trusting
    // the published progression: a gang id the player asserts is not a gang id.
    private _hg = _r select 3;
    if (_hg <= 0) exitWith { false };
    private _row = [format ["SELECT (gang0)::text AS gang0 FROM players WHERE playerid='%1'", _u], 2, true] call DB_fnc_asyncQuery;
    if !(_row isEqualType []) exitWith { false };
    private _pg = format ["%1", (_row param [0, []]) param [0, ""]];
    (_pg isNotEqualTo "") && {_pg isNotEqualTo "-1"} && {_pg isEqualTo (format ["%1", _hg])}
};

// The same question asked about a PRINTER rather than a house: resolve the building under it and
// defer. Used by queue and collect, which hold an anchor and not a house.
private _mayUsePrinter = {
    params ["_p", "_a", "_id"];
    if (isNull _a) exitWith { false };
    private _u = getPlayerUID _p;
    // owner 2026-09-26 SECURITY (houses review): installer and position come from the house_printers ROW -- never the
    // anchor's public AP_fabOwner (any client can setVariable it), nor the anchor's position (the anchor map was a
    // missionNamespace global a client publicVariable could repoint at an anchor standing in its own house).
    private _row = ([format ["SELECT owner, pos FROM house_printers WHERE id=%1", _id], 2, true] call DB_fnc_asyncQuery) param [0, []];
    if !(_row isEqualType [] && {_row isNotEqualTo []}) exitWith { false };
    // the installer always keeps access to their own machine, wherever it ended up
    if (_u isNotEqualTo "" && {(format ["%1", _row param [0, ""]]) isEqualTo _u}) exitWith { true };
    private _pp = (format ["%1", _row param [1, ""]]) splitString ":";
    if (count _pp < 3) exitWith { false };
    private _h = [[parseNumber (_pp select 0), parseNumber (_pp select 1), parseNumber (_pp select 2)]] call _resolveHouse;
    if (isNull _h) exitWith { false };
    [_p, _h] call _mayUse
};

// Spawn one printer: an invisible anchor carries the identity, the tags and the scroll actions,
// and the model is attachTo'd to it. The model has NO collision (owner call), so it cannot be hit
// by cursorObject and cannot host anything itself -- everything hangs off the anchor, and the
// client finds it by proximity. attachTo also renders the exact offset on every machine, which is
// what stops client-side PhysX settling the prop differently on different screens.
private _spawnPrinter = {
    params ["_id", "_tier", "_pos", "_dir", "_ownerUid", "_houseUid"];
    private _cfg = ["tier", _tier] call AP_fnc_fabCfg;
    private _model = _cfg param [4, "ap_printer_f770"];

    private _anchor = createVehicle ["Land_HelipadEmpty_F", [0, 0, -100], [], 0, "CAN_COLLIDE"];
    _anchor setDir _dir;
    _anchor setPosATL _pos;
    _anchor enableSimulationGlobal false;
    _anchor allowDamage false;
    _anchor setVariable ["AP_fabPrinter", true, true];
    _anchor setVariable ["AP_fabId", _id, true];
    _anchor setVariable ["AP_fabTier", _tier, true];
    _anchor setVariable ["AP_fabOwner", _ownerUid, true];
    _anchor setVariable ["AP_fabHomeOwner", _houseUid, true];
    _anchor setVariable ["AP_furniture", true, true];       // exempt from the cleanup sweep
    _anchor setVariable ["owner", "fabricator", true];      // exempt from the ownerless reap

    // The print window every client animates from: [started, ends] in serverTime (AP_fnc_fabAnim).
    // On a boot respawn the start is now -- nothing persists the pose, and it only has to move --
    // and the end is the longest job still running, from the database's clock like everything else.
    private _rem = [[format ["SELECT (COALESCE(MAX(GREATEST(finish_at - extract(epoch from now())::bigint, 0)), 0))::text AS n FROM house_printer_jobs WHERE printer_id=%1", _id], 2, true] call DB_fnc_asyncQuery] call _cell;
    _anchor setVariable ["AP_fabRun", [serverTime, serverTime + ([_rem] call _num)], true];

    // The visual is a client-local simple object per machine: getMissionPath, never a written-out
    // world name (the __cur_mp.Altis bug that made every model silently fail after the fork), and
    // the third argument true or a server running this spawns one copy per connected client.
    // Half the model's own height -- the models are bbox-centred, so this is what stands each one
    // on the floor. 0.2975 for the printers, 0.9463 for the bench.
    private _lift = _cfg param [8, 0.2975];
    // JIP-PERSISTENT, keyed per fabricator: the boot respawn runs before anyone is connected, and a plain
    // broadcast reached nobody -- the anchor was there (scroll actions worked) with no model to see
    // (owner, 2026-09-03). Cleared on pickup.
    [[_anchor, _model, _lift], "AP_fnc_fabModel", 0, "AP_fab_" + str _id, false] spawn AP_fnc_MP;

    _anchors set [_id, _anchor];
    _anchor
};

// Everything a client is allowed to know about the printers in one house, and what is in them.
// Row: [printerId, tier, slots, [[jobId, recipe, qty, remainingSeconds, ready], ...]]
// Deposit a collected job into the HOUSE's storage (houses.vinv / pinv), server-side -- owner 2026-09-03:
// "it should go into the house's inventory by default". Returns true when it landed there. Refuses, so the
// caller hands the item to the player instead, when there is no house, the trunk is OPEN (that session's
// close would overwrite the row), or it does not fit the house's cap. Read-merge-write on the row with the
// oracles and encoding APS_fnc_updateHouseTrunk uses; the server-local mirror on the house object is updated
// so a disconnect-path save does not resurrect the old contents.
private _deposit = {
    params ["_house", "_key", "_qty", "_isVirt", "_p"];
    if (isNull _house) exitWith { false };
    if (_house getVariable ["AP_trunkLock", false]) exitWith { false };
    // the row's oid (APS_fnc_houseRights), never the client-writable AP_houseID (owner 2026-09-26, houses review)
    private _oid = ((([_house] call APS_fnc_houseRights) select 0) splitString "\'""") joinString "";
    if (_oid in ["-1", ""]) exitWith { false };
    private _row = [format ["SELECT vinv, pinv, vcap, phys_cap FROM houses WHERE oid='%1'", _oid], 2] call DB_fnc_asyncQuery;
    if (!(_row isEqualType []) || {_row isEqualTo []}) exitWith { false };
    if ((_row select 0) isEqualType []) then { _row = _row select 0; };
    private _dec = {
        params [["_s", "", [""]]];
        if (_s in ["", "NULL"]) exitWith { [[], 0] };
        private _a = [_s] call DB_fnc_mresToArray;
        if (_a isEqualType "") then { _a = parseSimpleArray _a; };
        if (isNil "_a" || {!(_a isEqualType [])} || {_a isEqualTo []}) then { [[], 0] } else { _a }
    };
    private _inv = [format ["%1", _row param [([0, 1] select (!_isVirt)), ""]]] call _dec;
    private _items = +(_inv param [0, []]);
    if (!(_items isEqualType [])) then { _items = []; };
    private _cap = [_row param [([2, 3] select (!_isVirt)), 100]] call _num;
    if (_cap <= 0) then { _cap = 100; };
    private _addW = if (_isVirt) then { (["getItemWeight", _key] call AP_fnc_virtItemCfg) * _qty } else { [[_key, _qty]] call AP_fnc_physicalInventoryWeight };
    if (!(_addW isEqualType 0)) then { _addW = 0; };
    private _curW = if (_isVirt) then { _inv param [1, 0] } else { _items call AP_fnc_physicalInventoryWeight };
    if (!(_curW isEqualType 0)) then { _curW = 0; };
    if (_curW + _addW > _cap) exitWith { false };
    private _i = _items findIf { (_x param [0, ""]) isEqualTo _key };
    if (_i isEqualTo -1) then { _items pushBack [_key, _qty]; } else { _items set [_i, [_key, ((_items select _i) param [1, 0]) + _qty]]; };
    private _new = [_items, _curW + _addW];
    private _enc = (([_new] call DB_fnc_mresArray) splitString "'") joinString "''";
    [format ["UPDATE houses SET %1='%2' WHERE oid='%3'", ["vinv", "pinv"] select (!_isVirt), _enc, _oid], 2, true] call DB_fnc_asyncQuery;
    _house setVariable [["AP_vinv", "AP_pinv"] select (!_isVirt), _new];   // server-local mirror
    [_p, format ["%1 x%2 stored in the house.", _key, _qty]] call _say;
    ["-FAB-", _p, name _p, format ["deposited %1 x%2 into house %3", _key, _qty, _oid]] call APS_fnc_logIt;
    true
};

private _pushList = {
    params ["_p", "_h"];
    private _oid = ([_h] call APS_fnc_houseRights) select 0;   // the row, never the client-writable AP_houseID
    if (_oid in ["-1", ""]) exitWith {};
    private _prn = [format ["SELECT id, tier FROM house_printers WHERE oid='%1' ORDER BY id", _oid], 2, true] call DB_fnc_asyncQuery;
    if !(_prn isEqualType []) exitWith {};
    private _out = [];
    {
        private _pid = [_x param [0, 0]] call _num;
        private _tier = [_x param [1, 1]] call _num;
        private _slots = (["tier", _tier] call AP_fnc_fabCfg) param [0, 1];
        private _jr = [format ["SELECT id, recipe, qty,
            GREATEST(finish_at - extract(epoch from now())::bigint, 0) AS remaining,
            (CASE WHEN finish_at <= extract(epoch from now())::bigint THEN 1 ELSE 0 END) AS ready
            FROM house_printer_jobs WHERE printer_id=%1 ORDER BY id", _pid], 2, true] call DB_fnc_asyncQuery;
        private _jobs = [];
        if (_jr isEqualType []) then {
            {
                _jobs pushBack [[_x param [0, 0]] call _num, format ["%1", _x param [1, ""]],
                                [_x param [2, 0]] call _num, [_x param [3, 0]] call _num,
                                ([_x param [4, 0]] call _num) > 0];
            } forEach _jr;
        };
        _out pushBack [_pid, _tier, _slots, _jobs];
    } forEach _prn;
    [[_out], "AP_fnc_fabReceive", _p, false, false] spawn AP_fnc_MP;
};

call _ensure;

switch (_case) do {

    case "ensure": {};

    // ------------------------------------------------------------------ boot: respawn everything
    case "reload": {
        if (isRemoteExecuted) exitWith {};   // boot-only (init.sqf): a client-sent one re-spawned every printer (houses review 2026-09-26)
        private _rows = ["SELECT p.id, p.tier, p.pos, p.owner, h.owners, h.worldspace
                          FROM house_printers p JOIN houses h ON h.oid = p.oid", 2, true] call DB_fnc_asyncQuery;
        if !(_rows isEqualType []) exitWith {};
        private _n = 0;
        {
            _x params [["_id", 0], ["_tier", 1], ["_posStr", ""], ["_ownerUid", ""], ["_houseUid", ""], ["_ws", ""]];
            private _parts = (format ["%1", _posStr]) splitString ":";
            if (count _parts >= 4) then {
                private _pos = [parseNumber (_parts select 0), parseNumber (_parts select 1), parseNumber (_parts select 2)];
                private _dir = parseNumber (_parts select 3);
                [[_id] call _num, [_tier] call _num, _pos, _dir,
                 format ["%1", _ownerUid], format ["%1", _houseUid]] call _spawnPrinter;
                _n = _n + 1;
            };
        } forEach _rows;
        diag_log format ["[Armapunk][fab] respawned %1 printer(s)", _n];
    };

    case "list": {
        _data params [["_p", objNull, [objNull]], ["_h", objNull, [objNull]]];
        if (isNull _p || {isNull _h}) exitWith {};
        if !([_p, _h] call _mayUse) exitWith {};
        [_p, _h] call _pushList;
    };

    // ------------------------------------------------------------------------------- place
    case "place": {
        _data params [["_p", objNull, [objNull]], ["_h", objNull, [objNull]],
                      ["_tier", 1, [0]], ["_pos", [], [[]]], ["_dir", 0, [0]]];
        private _cfg = ["tier", _tier] call AP_fnc_fabCfg;
        private _item = _cfg param [3, "printer_i3"];
        // The client consumed the printer item before calling, so every refusal below MUST hand it
        // back. Getting a refund wrong in the player's favour is a rounding error; getting a grant
        // wrong in their favour is an economy.
        private _refund = { [_p, _item, 1] call _give };

        // numbers only: _pos is formatted into the house_printers INSERT below (owner 2026-09-26, houses review)
        if (isNull _p || {isNull _h} || {count _pos < 3} || {(_pos findIf { !(_x isEqualType 0) }) != -1}) exitWith { call _refund };
        // every tier the table knows (the bench is tier 3; a hard [1, 2] here refunded it silently since it was added)
        if (_tier < 1 || {_tier > (["tierCount"] call AP_fnc_fabCfg)}) exitWith { call _refund };
        if !([_p, _h] call _mayUse) exitWith {
            call _refund; [_p, "You need keys to this property to install a fabricator."] call _say;
        };
        private _hr = [_h] call APS_fnc_houseRights;   // row oid + owner, never AP_houseID / AP_homeOwner (houses review)
        private _oid = _hr select 0;
        if (_oid in ["-1", ""]) exitWith { call _refund };

        private _uid = getPlayerUID _p;
        if !(_uid regexMatch "\d{17}") exitWith { call _refund };
        private _have = [[format ["SELECT (COUNT(*))::text AS n FROM house_printers WHERE owner='%1'", _uid], 2, true] call DB_fnc_asyncQuery] call _cell;
        if (([_have] call _num) >= FAB_MAX_PER_PLAYER) exitWith {
            call _refund;
            [_p, format ["You already own %1 fabricators -- that is the limit. Pack one up to place another.", FAB_MAX_PER_PLAYER]] call _say;
        };
        private _posStr = format ["%1:%2:%3:%4", _pos select 0, _pos select 1, _pos select 2, _dir];
        [format ["INSERT INTO house_printers (oid, owner, tier, pos) VALUES ('%1','%2',%3,'%4')",
                 _oid, _uid, _tier, _posStr], 2, true] call DB_fnc_asyncQuery;
        // extDB3 pools connections, so there is no LAST_INSERT_ID to ask for -- read the row back.
        private _id = [[format ["SELECT (id)::text AS id FROM house_printers WHERE oid='%1' AND pos='%2' ORDER BY id DESC LIMIT 1", _oid, _posStr], 2, true] call DB_fnc_asyncQuery] call _cell;
        if (_id isEqualTo "") exitWith {
            call _refund; [_p, "The fabricator could not be registered. Nothing was consumed."] call _say;
        };
        [[_id] call _num, _tier, _pos, _dir, _uid, _hr select 1] call _spawnPrinter;
        [_p, format ["%1 installed.", _cfg param [5, "Fabricator"]]] call _say;
        [_p, _h] call _pushList;
        ["-FAB-", _p, name _p, format ["placed tier %1 (id %2, house %3)", _tier, _id, _oid]] call APS_fnc_logIt;
    };

    // ------------------------------------------------------------------------------- pickup
    case "pickup": {
        _data params [["_p", objNull, [objNull]], ["_id", -1, [0]]];
        if (isNull _p || {_id < 0}) exitWith {};
        private _lock = "p" + str _id;
        if (_busyMap getOrDefault [_lock, false]) exitWith { [_p, "That fabricator is busy."] call _say };
        _busyMap set [_lock, true];

        private _row = [format ["SELECT oid, owner, tier FROM house_printers WHERE id=%1", _id], 2, true] call DB_fnc_asyncQuery;
        private _r = _row param [0, []];
        if (_r isEqualTo []) exitWith { _busyMap deleteAt _lock; };
        private _uid = getPlayerUID _p;
        private _anchor = _anchors getOrDefault [_id, objNull];
        // the owner of the houses row the printer is registered in -- never the anchor's public AP_fabHomeOwner
        // (owner 2026-09-26 SECURITY, houses review: a forged tag let anyone pack up, and keep, a victim's printer)
        private _homeUid = format ["%1", (["SELECT COALESCE(owners,'') AS owners FROM houses WHERE oid = %s", 2, false, [format ["%1", _r param [0, ""]]]] call DB_fnc_asyncQuery) param [0, ""]];
        if (_homeUid in ["0", "NULL"]) then { _homeUid = ""; };
        // Uninstall keys on the HOUSE owner as well as the installer, mirroring the mining rig:
        // whoever owns the property must always be able to reclaim hardware left in it. Note this
        // is deliberately NARROWER than _mayUsePrinter -- a gang member may use a gang printer, but
        // only the installer or the property owner may take it away.
        if !((format ["%1", _r param [1, ""]]) isEqualTo _uid || {_homeUid isEqualTo _uid}) exitWith {
            _busyMap deleteAt _lock; [_p, "That is not your fabricator."] call _say;
        };
        private _jobs = [[format ["SELECT (COUNT(*))::text AS n FROM house_printer_jobs WHERE printer_id=%1", _id], 2, true] call DB_fnc_asyncQuery] call _cell;
        if (([_jobs] call _num) > 0) exitWith {
            _busyMap deleteAt _lock;
            [_p, format ["Empty the fabricator first -- %1 job(s) still in it.", _jobs]] call _say;
        };

        [format ["DELETE FROM house_printers WHERE id=%1", _id], 2, true] call DB_fnc_asyncQuery;
        // Prove the row is GONE before refunding. A silently-failed DELETE would respawn the
        // printer on the next reboot AND hand back a second copy of the item.
        private _left = [[format ["SELECT (COUNT(*))::text AS n FROM house_printers WHERE id=%1", _id], 2, true] call DB_fnc_asyncQuery] call _cell;
        if (_left isNotEqualTo "0") exitWith {
            _busyMap deleteAt _lock;
            diag_log format ["[Armapunk][fab] pickup WITHHELD: id=%1 still present after DELETE", _id];
            [_p, "The fabricator could not be removed. Try again."] call _say;
        };

        if (!isNull _anchor) then {
            [[_anchor], "AP_fnc_fabModelClear", 0, false, false] spawn AP_fnc_MP;
            remoteExec ["", "AP_fab_" + str _id];   // drop the JIP draw so a later joiner does not get a model for a gone anchor
            deleteVehicle _anchor;
        };
        _anchors deleteAt _id;
        private _tier = [_r param [2, 1]] call _num;
        [_p, ((["tier", _tier] call AP_fnc_fabCfg) param [3, "printer_i3"]), 1] call _give;
        [_p, "Fabricator packed up."] call _say;
        _busyMap deleteAt _lock;
        ["-FAB-", _p, name _p, format ["picked up tier %1 (id %2)", _tier, _id]] call APS_fnc_logIt;
    };

    // ------------------------------------------------------------------------------- queue
    case "queue": {
        _data params [["_p", objNull, [objNull]], ["_id", -1, [0]], ["_key", "", [""]], ["_qty", 1, [0]]];
        if (isNull _p || {_id < 0} || {_key isEqualTo ""}) exitWith {};
        _qty = ((round _qty) max 1) min 20;

        // Re-read the recipe from the SAME catalogue the client renders. The server compiles both
        // CfgFunctions trees into missionNamespace, so this is one source of truth, not a copy.
        private _recipe = ["getRecipe", _key] call AP_fnc_fabCfg;
        private _free = localNamespace getVariable ["AP_fabFreeBuild", false];   // FREE BUILD, the server's copy (see below)
        // In free build the client consumed nothing (fn_fabQueue / fn_deckFab), so a refund there hands back parts that
        // were never taken -- up to qty 20 of the recipe, on every refusal (r2fab). Refund only what was paid for.
        private _refund = {
            if (_free || {_recipe isEqualTo []}) exitWith {};
            { [_p, (_x select 0) select [7], (_x select 1) * _qty] call _give } forEach (_recipe select 1);
        };
        if (_recipe isEqualTo []) exitWith { [_p, "No such recipe."] call _say };

        private _row = ((([format ["SELECT owner, tier FROM house_printers WHERE id=%1", _id], 2, true] call DB_fnc_asyncQuery)) param [0, []]);
        if (_row isEqualTo []) exitWith { call _refund };

        private _anchor = _anchors getOrDefault [_id, objNull];
        if (isNull _anchor) exitWith { call _refund };
        if ((_p distance _anchor) > 6) exitWith { call _refund; [_p, "Stand at the fabricator."] call _say };

        private _uid = getPlayerUID _p;
        if !(_uid regexMatch "\d{17}") exitWith { call _refund };
        if !([_p, _anchor, _id] call _mayUsePrinter) exitWith {
            call _refund; [_p, "You do not have access to that fabricator."] call _say;
        };

        private _tier = [_row param [1, 1]] call _num;
        private _cfg = ["tier", _tier] call AP_fnc_fabCfg;
        private _slots = _cfg param [0, 1];

        // THE TWO-STAGE CHAIN, enforced here. A weapon is a "bench" recipe and only a gunsmith
        // bench will take it; everything else only a printer will. Without this the bench would
        // just be a second printer with a different model, and the receiver a pointless detour.
        private _needs = ["machineFor", _key] call AP_fnc_fabCfg;
        private _kind = _cfg param [6, "printer"];
        if (_needs isNotEqualTo _kind) exitWith {
            call _refund;
            [_p, if (_needs isEqualTo "bench") then {
                     "Weapons are assembled at a gunsmith bench, not printed. Print the lower receiver here and take it to a bench."
                 } else {
                     "A gunsmith bench only assembles weapons. Print that on a fabricator."
                 }] call _say;
        };
        private _busy = [[format ["SELECT (COUNT(*))::text AS n FROM house_printer_jobs WHERE printer_id=%1", _id], 2, true] call DB_fnc_asyncQuery] call _cell;
        if (([_busy] call _num) >= _slots) exitWith {
            call _refund;
            [_p, format ["Every slot on this %1 is running (%2/%2).", _cfg param [5, "fabricator"], _slots]] call _say;
        };

        _recipe params ["_lvl", "_parts", "_flags"];

        // FREE BUILD (APS_fnc_fabDebugSRV) skips the three gates that need a stocked player: the
        // ingredients, the fabrication level and the schematic. Read from the SERVER's own copy in
        // localNamespace, never from anything published or sent -- the missionNamespace global IS the
        // published copy, and one client publicVariable overwrote it here too (audit Lsec-0-1). The
        // client's copy exists only so the menu can grey the right things.
        //
        // Everything below this point still applies with it on. The machine must exist, be yours,
        // and be the right KIND for the recipe; the job still takes its full time; collect is
        // still fail-closed. Bypassing those would mean testing something other than the system.
        // (_free is read at the top of this case, because _refund needs it too.)

        if (!_free && {_lvl > (_cfg param [2, 10])}) exitWith {
            call _refund;
            [_p, format ["A %1 cannot print level %2 items.", _cfg param [5, "fabricator"], _lvl]] call _say;
        };

        // Progression and schematic ownership come from the server's OWN copies, never the published
        // ones -- a client can setVariable a public value on an object it owns, so validating against
        // the published copy would hand the gate straight back to it. Those copies are uid-keyed in
        // localNamespace, not on the unit: a client overwrites an UNpublished object var just as easily
        // (audit 2026-09-26, mints2).
        private _plvl = (localNamespace getVariable ["AP_fabLevelSrv", createHashMap]) getOrDefault [getPlayerUID _p, 1];
        if (!_free && {_lvl > _plvl}) exitWith {
            call _refund; [_p, format ["Fabrication level %1 required (you are %2).", _lvl, _plvl]] call _say;
        };
        // one flat test: an exitWith nested in an if-then only left that block, so this refusal
        // refunded the materials AND still queued the job
        if (!_free && {!("noSchematic" in _flags)} && {!(_key in ((localNamespace getVariable ["AP_fabSchemSrv", createHashMap]) getOrDefault [getPlayerUID _p, []]))}) exitWith {
            call _refund; [_p, "You have not learned that schematic."] call _say;
        };

        private _secs = round (((["duration", _key] call AP_fnc_fabCfg) * _qty) / (_cfg param [1, 1]));
        if (_secs < 1) then { _secs = 1 };
        [format ["INSERT INTO house_printer_jobs (printer_id, recipe, qty, finish_at)
                 VALUES (%1,'%2',%3, extract(epoch from now())::bigint + %4)",
                 _id, _key, _qty, _secs], 2, true] call DB_fnc_asyncQuery;
        // Prove the job landed before telling the player it did. asyncQuery cannot tell a rejected
        // write from a successful one, and a silently-lost INSERT would eat their materials.
        private _chk = [[format ["SELECT (COUNT(*))::text AS n FROM house_printer_jobs WHERE printer_id=%1 AND recipe='%2'", _id, _key], 2, true] call DB_fnc_asyncQuery] call _cell;
        if (([_chk] call _num) <= 0) exitWith {
            call _refund;
            diag_log format ["[Armapunk][fab] queue WITHHELD: id=%1 job did not commit", _id];
            [_p, "The fabricator did not accept the job. Materials returned."] call _say;
        };

        // extend the machine's print window (what the clients animate); a fresh window starts now
        (_anchor getVariable ["AP_fabRun", [0, 0]]) params [["_r0", 0], ["_r1", 0]];
        if (serverTime >= _r1) then { _r0 = serverTime; };
        _anchor setVariable ["AP_fabRun", [_r0, (serverTime + _secs) max _r1], true];
        [_p, format ["Printing %1 x %2 -- %3 min. It runs while you are offline.",
                     _qty, _key, (_secs / 60) toFixed 1]] call _say;
        [_p, [getPosATL _anchor] call _resolveHouse] call _pushList;
        ["-FAB-", _p, name _p, format ["queued %1 x%2 on id %3 (%4s, tier %5, slot %6/%7)",
            _key, _qty, _id, _secs, _tier, ([_busy] call _num) + 1, _slots]] call APS_fnc_logIt;
    };

    // ------------------------------------------------------------------------------- collect
    // Collects EVERY finished job on the machine, each one independently: its own lock, its own
    // blocking delete, its own proof read, its own grant. One job failing its proof withholds that
    // job and nothing else -- batching them into a single transaction would mean one bad row either
    // blocks a good grant or, worse, rides along with it.
    case "collect": {
        _data params [["_p", objNull, [objNull]], ["_id", -1, [0]]];
        if (isNull _p || {_id < 0}) exitWith {};

        private _anchor = _anchors getOrDefault [_id, objNull];
        if (isNull _anchor) exitWith {};
        if !([_p, _anchor, _id] call _mayUsePrinter) exitWith { [_p, "That is not your fabricator."] call _say };

        private _due = [format ["SELECT id, recipe, qty FROM house_printer_jobs
            WHERE printer_id=%1 AND finish_at <= extract(epoch from now())::bigint ORDER BY id", _id], 2, true] call DB_fnc_asyncQuery;
        if !(_due isEqualType []) exitWith {};
        if (_due isEqualTo []) exitWith { [_p, "Nothing finished in that fabricator yet."] call _say };

        private _got = 0;
        {
            private _jid = [_x param [0, 0]] call _num;
            private _key = format ["%1", _x param [1, ""]];
            private _qty = ([_x param [2, 0]] call _num) max 0;
            if (_key isNotEqualTo "" && {_qty > 0} && {!(_busyMap getOrDefault ["j" + str _jid, false])}) then {
                _busyMap set ["j" + str _jid, true];

                [format ["DELETE FROM house_printer_jobs WHERE id=%1", _jid], 2, true] call DB_fnc_asyncQuery;
                private _left = [[format ["SELECT (COUNT(*))::text AS n FROM house_printer_jobs WHERE id=%1", _jid], 2, true] call DB_fnc_asyncQuery] call _cell;
                if (_left isEqualTo "0") then {
                    private _isVirt = (["getItemRow", _key] call AP_fnc_virtItemCfg) isNotEqualTo [];
                    // output goes into the HOUSE's storage by default (owner 2026-09-03); to the player only
                    // when the house cannot take it (no house, trunk open, no room)
                    if !([[getPosATL _anchor] call _resolveHouse, _key, _qty, _isVirt, _p] call _deposit) then {
                        if (_isVirt) then { [_p, _key, _qty] call _give; }
                        else { [[_key, _qty], "AP_fnc_fabGiveGear", _p, false, false] spawn AP_fnc_MP; };
                    };

                    // XP under the level +/-1 window, evaluated against the level held at COLLECT.
                    private _lvl = (["getRecipe", _key] call AP_fnc_fabCfg) param [0, 1];
                    private _plvl = (localNamespace getVariable ["AP_fabLevelSrv", createHashMap]) getOrDefault [getPlayerUID _p, 1];
                    if (_lvl >= (_plvl - 1) && {_lvl <= _plvl}) then { [_p, _qty] call APS_fnc_fabXp; };

                    [[_key, _qty], "AP_fnc_fabQuestEvent", _p, false, false] spawn AP_fnc_MP;
                    _got = _got + 1;
                    ["-FAB-", _p, name _p, format ["collected %1 x%2 (job %3, printer %4)", _key, _qty, _jid, _id]] call APS_fnc_logIt;
                } else {
                    diag_log format ["[Armapunk][fab] collect WITHHELD: job %1 did not clear", _jid];
                };
                _busyMap deleteAt ("j" + str _jid);
            };
        } forEach _due;

        if (_got isEqualTo 0) then { [_p, "The fabricator did not release anything. Try again."] call _say; }
        else { [_p, format ["Collected %1 finished job(s).", _got]] call _say; };
        [_p, [getPosATL _anchor] call _resolveHouse] call _pushList;
    };
};
