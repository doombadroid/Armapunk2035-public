# deploy/secrets.example.env -- TEMPLATE for the gitignored deploy/secrets.env (real credentials).
# Copy to secrets.env on the box, set real values. Sourced by run-boot2 + the DB-tooling scripts.
# owner 2026-07-10: keeps Arma admin passwords + the DB password out of git.
AP_ADMIN_PW=CHANGE_ME_ADMIN          # Arma passwordAdmin  (#login)
AP_CMD_PW=CHANGE_ME_CMD              # Arma serverCommandPassword
LOONEYBIN_DB_PASS=looneybin           # MariaDB 'looneybin' app-user password (extDB3 + all bot/deploy tooling)
