# deploy/systemd/pysqfd.env.example -- copy to ~/.config/armapunk/pysqfd.env (chmod 600) and fill the password.
# PYSQF_SOCKET MUST equal the value in deploy/live/run-live.sh (2026-08-21: mismatched defaults = silent extDB3 fallback).
PYSQF_SOCKET=/run/user/1000/pysqf.sock
PYSQF_DB_DSN=host=127.0.0.1 port=5432 dbname=armapunk user=armapunk password=CHANGEME
AP_DB_POSTGRES=1
AP_WEBPAGES_ROOT=/home/timb/Armapunk2035/server/AP_server/web
PYTHONPATH=/home/timb/PySQF/python:/home/timb/Armapunk2035/tools/pysqf_modules:/home/timb/Armapunk2035/tools/pgmigrate
# Telemetry (TELEMETRY_SPEC.md): where tools/pysqf_modules/telemetry.py posts Prometheus lines, and the
# host label every sample carries. Unset URL = the default below; AP_TELEMETRY_ENABLED=0 turns it off.
AP_TELEMETRY_URL=http://127.0.0.1:8428/api/v1/import/prometheus
AP_TELEMETRY_HOST=live
