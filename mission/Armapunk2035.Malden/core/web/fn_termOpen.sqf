/*
    fn_termOpen.sqf  (AP_fnc_termOpen) -- boot the SEQUENCE BREACH page.

    The grid and the buffer are generated by fn_cyberdeckSeq and left in
    AP_cbWebCfg; this hands them to the page and waits for its verdict.

    The page reports the outcome rather than being asked for it. That is not a new
    trust boundary: the native minigame ran entirely on the client too, and the
    thing it gates (a lockpick, an ATM, a gate) is re-checked server-side where it
    matters.
*/
params [["_display", displayNull, [displayNull]]];
if (isNull _display) exitWith { diag_log "[TERM] null display" };
disableSerialization;

private _ctrl = _display displayCtrl 937801;
if (isNull _ctrl) exitWith { diag_log "[TERM] control 937801 missing"; AP_breachResult = -1 };
if !([_ctrl] call webui_fnc_init) exitWith { diag_log "[TERM] bridge init failed"; AP_breachResult = -1 };
// Let the SERVER replace this page's markup if it holds a newer copy, so UI ships
// without a client repack. No-op unless AP_fnc_webServeInit registered a fetcher and
// the server actually has the file -- otherwise the PBO page you just loaded stands.
[_ctrl, "ui\html\terminal.html"] call webui_fnc_serve;
[_ctrl] call AP_fnc_casinoFit;

[_ctrl, "breachDone", {
    params [["_r", -1, [0]]];
    AP_breachResult = _r;
    // let the verdict sit on screen the way the native one did
    [] spawn { uiSleep 1.1; if (!isNull (findDisplay 937800)) then { closeDialog 0 } };
    createHashMapFromArray [["ok", true], ["msg", ""]]
}] call webui_fnc_on;

[_ctrl, "breach", (missionNamespace getVariable ["AP_cbWebCfg", createHashMap])] call webui_fnc_push;
diag_log format ["[TERM] page up, buffer %1", (missionNamespace getVariable ["AP_cbWebCfg", createHashMap]) getOrDefault ["time", 0]];
