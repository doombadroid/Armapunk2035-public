/*
    AP_fnc_gpsInit  (LooneyBin, owner 2026-07-12)
    Lazy one-shot loader for the road graph (core\gps\roadgraph_data.sqf, generated by
    tools/roadgraph_build.py). Builds:
        AP_gpsNodes  [[x,y], ...]                        junction positions, idx = node id
        AP_gpsEdges  [[a, b, len, cls, poly], ...]       polyline edges between junctions
        AP_gpsAdj    idx -> [[neighbor, cost, edgeIdx]]  adjacency for A* (cost = len * road-class
                                                          factor, so routes PREFER highways like a
                                                          real GPS "fastest" mode)
        AP_gpsCells  HashMap "cx_cy" -> [[edgeIdx, vertIdx], ...]  300m spatial hash of every
                                                          polyline vertex (start/dest edge snapping)
    ~860KB compile + index build happens ONCE, on first GPS use, not at login.
*/
#define GPS_CELL 300
if (!isNil "AP_gpsAdj") exitWith { true };
private _t0 = diag_tickTime;
private _data = call compile preprocessFileLineNumbers "core\gps\roadgraph_data.sqf";
if (isNil "_data" || {!(_data isEqualType [])} || {count _data < 2}) exitWith {
    diag_log "[LooneyBin][gps] roadgraph_data.sqf failed to load";
    false};
_data params ["_nodes", "_edges"];
private _adj = [];
_adj resize count _nodes;
for "_i" from 0 to (count _nodes - 1) do { _adj set [_i, []]; };
private _cells = createHashMap; {_x params ["_a", "_b", "_len", "_cls", "_ped", "_poly", ["_oneway", 0]];
    // road-class cost factor by TYPE (engine width lies -- tracks report 10m):
    // 0 MAIN ROAD 1.0, 1 ROAD 1.05, 2 TRACK 1.35, 3 HIDE 6.0 (hidden roads render on no map).
    // Pedestrian alleys (Athira park cuts etc.) x2.5 on top -- cars should never be sent there,
    // but dead-end starts can still escape.
    private _cost = _len * ([1.0, 1.05, 1.35, 6.0] param [_cls, 1.35]) * ([1, 2.5] select (_ped > 0));
    // ONE-WAY (7th field, absent = 0 = two-way): only the legal direction enters the adjacency, so
    // the A* in AP_fnc_routeFind cannot plot against the flow without knowing anything about it.
    // 1 = a->b only, -1 = b->a only. Used by the Malden bridge, whose two carriageways are separate
    // one-way decks ~25.6m apart -- a two-way link there routes half of all crossings into oncoming.
    if (_oneway != -1) then { (_adj select _a) pushBack [_b, _cost, _forEachIndex]; };
    if (_oneway != 1) then { (_adj select _b) pushBack [_a, _cost, _forEachIndex]; };
    private _ei = _forEachIndex; {private _key = format ["%1_%2", floor ((_x select 0) / GPS_CELL), floor ((_x select 1) / GPS_CELL)];
        (_cells getOrDefaultCall [_key, { [] }, true]) pushBack [_ei, _forEachIndex];} forEach _poly;} forEach _edges;
AP_gpsNodes = _nodes;
AP_gpsEdges = _edges;
AP_gpsAdj = _adj;
AP_gpsCells = _cells;
diag_log format ["[LooneyBin][gps] graph loaded: %1 nodes, %2 edges (%3 one-way), %4 cells in %5ms",
    count _nodes, count _edges, ({(_x param [6, 0]) != 0} count _edges), count _cells,
    ((diag_tickTime - _t0) * 1000) toFixed 0];
true
