if (isNull objectParent player && player distance cursorObject > 8) exitWith {};
params[["_position", "", [""]]];
switch (_position) do {case "driver": {cursorObject lock false;
            player action["getInDriver", cursorObject];
            cursorObject lock true;}; case "passenger": {cursorObject lock false;
                player action["getInCargo", cursorObject];
                cursorObject lock true;};
        case "commander": {cursorObject lock false;
                player action["getInCommander", cursorObject];
                cursorObject lock true;};
        case "gunner": {[] spawn {private _vehicle = cursorObject;
                    _vehicle lock false;
                    player action["getInCargo", _vehicle];
                    uiSleep 0.5;
                    if (typeOf _vehicle in ["O_T_LSV_02_unarmed_F", "B_T_LSV_01_unarmed_F"]) then {player moveInCargo _vehicle};
                    _vehicle lock true;
                    if (isNull objectParent player) then {_vehicle lock true;} else {vehicle player lock true};};};
        case "exit": {private _veh = vehicle player;
                _veh lock false;
                player action["getOut", _veh];
                _veh lock true;};
        case "dlcDriver": {player moveInDriver cursorObject;};};