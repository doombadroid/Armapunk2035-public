params[["_className", "", [""]], ["_vehicle", objNull, [objNull]], ["_preset", false, [false]], ["_skinID", -1, [0]], ["_showDoors", false, [false]]];
private _animate =
switch (AP_effSide) do {case west: {switch (true) do {case ((_className find "Quadbike") > -1): {"cop_quad"};
                case ((_className find "SUV_01") > -1): {"cop_suv"};
                case ((_className find "MRAP_01") > -1): {"cop_hunter"};
                case ((_className find "MRAP_03") > -1): {"cop_strider"};
                case ((_className find "Hatchback") > -1): {"cop_sport"};
                case ((_className find "LSV_01") > -1): {"cop_prowler"};
                case ((_className find "Van_02_transport") > -1): {"cop_dlcVan"};
                case ((_className find "Offroad_01") > -1): {if (_skinID isEqualTo 7) then {"cop_offroad"} else {"civ_offroad"}};
                case ((_className find "Offroad_02") > -1): {"cop_jeep"};
                case ((_className find "Heli_Light_01") > -1): {"cop_littlebird"};
                case ((_className find "Heli_Light_02") > -1): {"cop_orca"};
                case ((_className find "Heli_Light_03") > -1): {"cop_hellcat"};
                case ((_className find "Heli_Transport_01") > -1): {"cop_ghosthawk"};
                case (_className isEqualTo "O_T_LSV_02_unarmed_F"): {"cop_qilin"};
                case (_className isEqualTo "O_APC_Wheeled_02_rcws_v2_F"): {"cop_apc"};
                case ((_className find "I_Heli_light_03_F") > -1): {"cop_benchhellcat"};}};
    case civilian: {switch (true) do {case (_className isEqualTo "I_Heli_light_03_F"): {"civ_benchhellcat"};
                case (_className isEqualTo "C_Offroad_01_F"): {"civ_offroad"};
                case (_className isEqualTo "C_Offroad_02_unarmed_F"): {"civ_jeep"};
                case (_className isEqualTo "O_T_LSV_02_unarmed_F"): {"civ_qilin"};
                case (_className isEqualTo "B_T_LSV_01_unarmed_F"): {"civ_prowler"};
                case (_className isEqualTo "C_Van_02_transport_F"): {"civ_dlcVan"};
                case (_className isEqualTo "I_G_Offroad_01_repair_F"): {"civ_offroadService"};
                case (_className isEqualTo "I_LT_01_cannon_F"): {"civ_nyx"};};};
    case independent: {switch (true) do {case (_className isEqualTo "C_Offroad_01_F"): {"med_offroad"};
                case (_className isEqualTo "C_SUV_01_F"): {"med_suv"};};};}; if (isNull _vehicle) exitwith {};
if !(_preset) then {if (count _animate > 1) then {{_vehicle animate[_x select 0, _x select 1];}
        forEach _animate;} else {_vehicle animate[_animate select 0, _animate select 1];};} else {switch (_animate) do {
        case "civ_benchhellcat": {_vehicle animate["hideweapons", 1];
                _vehicle animate["rocketpods", 1];}; case "civ_qilin": {if (true) then {if (_showDoors) exitWith {};
                        _vehicle animate["unarmed_doors_hide", 1];};};
            case "civ_prowler": {if (true) then {if (_showDoors) exitWith {};
                        _vehicle animate["hidedoor1", 1];
                        _vehicle animate["hidedoor2", 1];
                        _vehicle animate["hidedoor3", 1];
                        _vehicle animate["hidedoor4", 1];};};
            case "civ_littlebird": {_vehicle animate["addDoors", 1];
                    _vehicle animate["addBenches", 0];
                    _vehicle animate["addTread", 0];
                    _vehicle animate["AddCivilian_hide", 1];
                    _vehicle lockCargo[2, true];
                    _vehicle lockCargo[3, true];
                    _vehicle lockCargo[4, true];
                    _vehicle lockCargo[5, true];};
            case "civ_offroad": {_vehicle animate["HidePolice", 1];
                    _vehicle animate["HideBumper1", selectRandom[0, 1]];
                    _vehicle animate["HideConstruction", 1];
                    _vehicle animate["HideServices", 1];
                    _vehicle setVariable["AP_lights", false, true];
                    _vehicle animate["hidebackpacks", selectRandom[0, 1]];};
            case "civ_offroadService": {_vehicle setRepairCargo 0;
                    _vehicle setVariable["AP_lights", false, true];};
            case "civ_jeep": {_vehicle animate["hideLeftDoor", selectRandom[0, 1]];
                    _vehicle animate["hideRightDoor", selectRandom[0, 1]];
                    _vehicle animate["hideRearDoor", selectRandom[0, 1]];
                    _vehicle animate["hideBullbar", selectRandom[0, 1]];
                    _vehicle animate["hideFenders", selectRandom[0, 1]];
                    _vehicle animate["hideHeadSupportFront", selectRandom[0, 1]];
                    _vehicle animate["hideHeadSupportRear", selectRandom[0, 1]];
                    _vehicle animate["hideRollcage", selectRandom[0, 1]];
                    _vehicle animate["hideSeatsRear", selectRandom[0, 1]];
                    _vehicle animate["hideSpareWheel", selectRandom[0, 1]];};
            case "reb_littlebird": {_vehicle animate["addDoors", 0];
                    _vehicle animate["addBenches", 1];
                    _vehicle animate["addTread", 1];
                    _vehicle animate["AddCivilian_hide", 0];};
            case "cop_prowler": {if (_showDoors) exitWith {};
                    _vehicle animate["hidedoor1", 1];
                    _vehicle animate["hidedoor2", 1];
                    _vehicle animate["hidedoor3", 1];
                    _vehicle animate["hidedoor4", 1];
                    _vehicle setVariable["AP_lights", false, true];};
            // These presets do nothing but switch the light-bar variable off. Folded into one
            // fall-through arm: in SQF a case with no code block runs the next case's block
            // (BIKI switch). "cop_littlebird" was listed twice before -- the second arm was
            // unreachable and byte-identical, so dropping it changes nothing.
            case "cop_dlcVan"; case "cop_jeep"; case "cop_littlebird"; case "cop_orca";
            case "cop_hellcat"; case "cop_ghosthawk"; case "cop_suv"; case "cop_sport";
            case "cop_quad"; case "cop_hunter"; case "cop_strider"; case "med_suv": {_vehicle setVariable["AP_lights", false, true];};
            case "cop_benchhellcat": {_vehicle animate["hideweapons", 1];
                    _vehicle animate["rocketpods", 1];
                    _vehicle setVariable["AP_lights", false, true];};
            case "cop_offroad": {_vehicle animate["HidePolice", 0];
                    _vehicle animate["HideBumper1", 0];
                    _vehicle animate["HideConstruction", 0];
                    _vehicle animate["HideServices", 1];
                    _vehicle setVariable["AP_lights", false, true];};
            case "cop_qilin": {_vehicle setVariable["AP_lights", false, true];
