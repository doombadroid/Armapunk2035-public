private _blurbById = createHashMap;
{ _x params ["", "", "_bl", "", "", "", "", "", "", "", "", "", ["_rm", -1]]; if (_rm > -1) then { _blurbById set [_rm, _bl]; }; } forEach (["civ"] call AP_fnc_qhCfg);
{
    _x params ["_itemId", "_pair"];                 // toArray false -> [key, value] pairs (no HashMap _x/_y ambiguity)
    _pair params ["_numId", "_label"];
    private _mod = (AP_cdModules select { (_x select 0) isEqualTo _numId }) param [0, []];
    private _txt = if (_mod isNotEqualTo []) then { _mod select 3 } else { _blurbById getOrDefault [_numId, _label] };
    AP_itemDesc set [_itemId, format ["%1 -- USE to install. %2", _label, _txt]];
} forEach (AP_chipItemMap toArray false);

// ============================ NEW DRACHMA client helpers (2026-07-23) ============================
// The wallet is server-authoritative (players.new_drachma DECIMAL(20,4), APS_fnc_ndSRV). AP_ndStr holds
// the EXACT 4dp balance as a STRING; AP_nd is a 32-bit float mirror kept only for legacy
// afford-checks/labels. All spend/earn flows go through the server; these are the client-side helpers.
if (isNil "AP_ndStr") then { AP_ndStr = "0"; };
AP_ndPending = createHashMap;   // token -> [onOkCode, ctx, t0]
AP_ndTokSeq = 0;
// pretty-print a 4dp ND string/number: trim trailing zeros + dot, thousands-separate the integer part.
AP_fnc_ndText = compileFinal {
    private _s = _this;
    if (_s isEqualType []) then { _s = _s param [0, "0"]; };   // callers pass [value] -- unwrap like ndFromLegacy
    if (_s isEqualType 0) then { _s = _s toFixed 4; };
    if (!(_s isEqualType "") || {_s isEqualTo ""}) exitWith { "0" };
    private _neg = false;
    if ((_s select [0,1]) isEqualTo "-") then { _neg = true; _s = _s select [1]; };
    private _parts = _s splitString ".";
    private _i = _parts param [0, "0"];
    private _f = _parts param [1, ""];
    while { count _f > 0 && { (_f select [count _f - 1, 1]) isEqualTo "0" } } do { _f = _f select [0, (count _f) - 1]; };
    private _out = ""; private _c = count _i;
    for "_k" from 0 to (_c - 1) do {
        if (_k > 0 && { ((_c - _k) mod 3) isEqualTo 0 }) then { _out = _out + ","; };
        _out = _out + (_i select [_k, 1]);
    };
    if (_f isNotEqualTo "") then { _out = _out + "." + _f; };
    if (_neg) then { _out = "-" + _out; };
    _out
};
// convert a legacy-denominated config number (reward/price fallback) to a 4dp ND string, min 0.0001 if >0.
AP_fnc_ndFromLegacy = compileFinal {
    private _bm = _this;
    if (_bm isEqualType []) then { _bm = _bm param [0, 0]; };
    if !(_bm isEqualType 0) then { _bm = 0; };
    private _r = (round ((_bm / 6000) * 10000)) / 10000;
    if (_bm > 0 && {_r <= 0}) then { _r = 0.0001; };
    _r toFixed 4
};
// exact wallet-covers-price test (string-decimal, NO float): [priceStr|num] -> bool.
AP_fnc_ndAfford = compileFinal {
    private _price = _this;
    if (_price isEqualType []) then { _price = _price param [0, "0"]; };   // callers pass [value] -- unwrap
    if (_price isEqualType 0) then { _price = _price toFixed 4; };
    private _pad = {
        private _pp = _this splitString ".";
        private _i = _pp param [0, "0"]; private _f = _pp param [1, ""];
        while { count _f < 4 } do { _f = _f + "0"; };
        while { count _i < 16 } do { _i = "0" + _i; };
        _i + _f
    };
    private _a = toArray (AP_ndStr call _pad);
    private _b = toArray (_price call _pad);
    private _ge = true;
    for "_k" from 0 to (count _a) - 1 do {
        if ((_a select _k) != (_b select _k)) exitWith { _ge = (_a select _k) > (_b select _k); };
    };
    _ge
};
// fire a server-capped credit request: [amtStr|num, reason].
AP_fnc_ndRequest = compileFinal {
    params [["_amt", "0", ["", 0]], ["_reason", "", [""]]];
    if (_amt isEqualType 0) then { _amt = _amt toFixed 4; };
    [["credit", _amt, _reason], "APS_fnc_ndSRV", 2, false] spawn AP_fnc_MP;
};
// token-based purchase: [amtStr|num, onOkCode, ctx] -> token. Stashes the grant continuation, fires the
// atomic server debit, and spawns a 15s timeout sweeper. AP_fnc_ndResult runs onOk on success.
AP_fnc_ndBuy = compileFinal {
    params [["_amt", "0", ["", 0]], ["_onOk", {}, [{}]], ["_ctx", [], [[]]]];
    if (_amt isEqualType 0) then { _amt = _amt toFixed 4; };
    AP_ndTokSeq = AP_ndTokSeq + 1;
    private _tok = format ["nd%1_%2", round (diag_tickTime * 1000), AP_ndTokSeq];
    AP_ndPending set [_tok, [_onOk, _ctx, diag_tickTime]];
    AP_action_in_use = true;
    [["debit", _amt, _tok], "APS_fnc_ndSRV", 2, false] spawn AP_fnc_MP;
    [_tok] spawn {
        params ["_tok"];
        uiSleep 15;
        if ((AP_ndPending getOrDefault [_tok, []]) isNotEqualTo []) then {
            AP_ndPending deleteAt _tok;
            AP_action_in_use = false;
            ["New Drachma transaction timed out -- try again.", "basic"] spawn AP_fnc_handleMessage;
        };
    };
    _tok
};
AP_ndResults = createHashMap;   // token -> [ok, newStr] for blocking AP_fnc_ndBuySync waiters
// BLOCKING purchase: [amtStr|num] -> bool (paid?). MUST run in a scheduled context (waitUntil). Keeps the
// caller's grant code straight-line: fire the atomic server debit, wait for AP_fnc_ndResult to publish
// the outcome, return it. 15s timeout -> false (server dead / packet lost).
AP_fnc_ndBuySync = compileFinal {
    params [["_amt", "0", ["", 0]]];
    if (_amt isEqualType 0) then { _amt = _amt toFixed 4; };
    AP_ndTokSeq = AP_ndTokSeq + 1;
    private _tok = format ["nds%1_%2", round (diag_tickTime * 1000), AP_ndTokSeq];
    AP_ndResults deleteAt _tok;
    [["debit", _amt, _tok], "APS_fnc_ndSRV", 2, false] spawn AP_fnc_MP;
    private _t0 = diag_tickTime;
    waitUntil { (_tok in AP_ndResults) || {diag_tickTime - _t0 > 15} };
    private _res = AP_ndResults getOrDefault [_tok, [false]];
    AP_ndResults deleteAt _tok;
    _res param [0, false]
};

AP_fnc_lbS = compileFinal {missionNamespace getVariable ["AP_lbState", [false, 0, false, 0, false, false, false, false]]};   // Loony Bin heist phase state (see APS_fnc_loonyBinSRV)

// Loony Bin heist proximity test. mapData props are placed with setPosWorld, so their z is in the
// WORLD frame while `player distance <array>` reads the player in the AGL frame -- comparing the two
// put every prop ~28 m away and refused every step (caught live 2026-08-01). getPosWorld on both
// sides is the whole fix, and being genuinely 3D it also tells the two laptops apart by floor.
AP_fnc_lbAt = compileFinal {
    params ["_key", ["_fallback", []], ["_r", 5]];
    private _p = missionNamespace getVariable [_key, _fallback];
    if (_p isEqualTo []) exitWith { false };
    ((getPosWorld player) distance _p) < _r
};
AP_fnc_boostLamp = compileFinal {
    // owner 2026-08-02: placed lights are "super dim" -- stock switchLight emitters. Attach a real
    // lightpoint at ~bulb height: LOCAL object (this whole loader is client-side), tunables here.
    // Injected by the map pipeline into every auto-lit light row ("_this call AP_fnc_boostLamp").
    private _bb = boundingBoxReal _this;
    private _h = ((_bb select 1) select 2) * 0.85;
    private _lp = "#lightpoint" createVehicleLocal [0, 0, 0];
    _lp setLightBrightness 8;    // owner 2026-08-02: 4 still read dim on short posts (LampDecor)
    _lp setLightColor [1, 0.86, 0.62];
    _lp setLightAmbient [0.15, 0.14, 0.10];
    _lp setLightAttenuation [1, 0, 0, 0.025];
    _lp setLightUseFlare false;
    _lp attachTo [_this, [0, 0, _h]];
    _lp
};

