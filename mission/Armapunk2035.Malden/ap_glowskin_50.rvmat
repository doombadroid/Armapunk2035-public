// ap_glowskin_50.rvmat -- self-lit material for an HTML SKIN, emissive 50. One of a ladder
// (4 12 25 50 100 200 400); fn_htmlSkin's 5th arg is the emissive you want and it picks the nearest
// file. An rvmat is an engine file and cannot be served, so the ladder lives in the PBO and the art
// stays served HTML. Whole selection is emissive: the page's dark ground glows at its own darkness.
// Stages: the flat Super ladder from ap_vendsign (generic file, the garment's own normal map is lost).
ambient[]={1,1,1,1};
diffuse[]={1,1,1,1};
forcedDiffuse[]={0,0,0,0};
emmisive[]={50,50,50,1};
specular[]={0.35,0.35,0.35,1};
specularPower=60;
PixelShaderID="Super";
VertexShaderID="Super";
class Stage1
{
	texture="#(argb,8,8,3)color(0.5,0.5,1,1,NOHQ)";
	uvSource="tex";
	class uvTransform
	{
		aside[]={1,0,0};
		up[]={0,1,0};
		dir[]={0,0,1};
		pos[]={0,0,0};
	};
};
