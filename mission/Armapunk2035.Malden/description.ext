// Web UI bridge: local pages loaded by a CT_WEBBROWSER url= are subject to this
// whitelist. "+=" EXTENDS the engine defaults rather than replacing them, so no
// existing htmlLoad / ctrlSetURL / menuSetURL usage elsewhere is restricted.
class CfgCommands
{
	// Without this a page renders perfectly and can never call back — there is
	// no error. Covers the mission's own pages and anything shipped under the
	// arma-webui library directory.
	allowedHTMLLoadURIs[] += {
		"ui\\html\\*",
		"ui\\html\\casino\\*",
		"webui\\ui\\*",
		"ArmaQuest\\ui\\*"
	};
};
