// Include order is load-bearing and NOT what it looks like: measured directly on
// this engine, a later same-named "class Foo {...}" redeclaration does NOT win
// over an earlier one for members both declare -- the engine logs "Member already
// defined" and keeps the FIRST value, full stop (self-inheritance "class Foo :
// Foo {}" changes nothing; tested, byte-identical outcome). So OURS goes first:
// our narrow override (store/sqlExec) claims those members, then the library's
// defaults fill in everything else it does not collide with, unharmed.
// AQ_HOST_CONTENT suppresses ArmaQuest's SAMPLE content (its AQ_Settings, AQ_Quests,
// AQ_Templates, AQ_Pools, AQ_Givers and profile_default's AQ_Profile). Ours are
// authored in aq_content.hpp, deliberately outside the vendored tree so a re-vendor
// cannot overwrite them -- and without this define BOTH files declare all six, which
// the engine reports as "Member already defined" in a MESSAGE BOX the player clicks
// past at every startup. Not fatal, which is why it survived this long: the classes
// merge, the mission runs, and it just looks broken.
//
// Nothing is lost by suppressing them. The library's AQ_Settings was never actually
// contributing: ours is parsed first and wins the class outright, which is provable
// from the boot log -- flushInterval and sweepInterval come out as 60/5, ArmaQuest's
// own CODE defaults, not the 30/60 its config sets. tools/aq_check.py now fails if
// upstream adds a setting we do not carry, so that stays true.
//
// AQ_TypeProbe is still defined by the library either way; aq_fnc_registerType probes
// custom objective types against it.
#define AQ_HOST_CONTENT
#include "aq_content.hpp"                       // OURS: settings, givers, content
#include "ArmaQuest\config\CfgArmaQuest.hpp"   // shipped types (AQ_TypeProbe)
class RscTitles{
	// CONNECT-TIME CACHE WORKER -- an invisible browser that pulls the map's three
	// text assets, all 169 sat tiles at two mips and every item icon through A3API
	// at connect, so the conversion cost lands during the loading screen and not on
	// the first press of M, the first shop or the first inventory. Never shown.
	// See ui\html\warm.html and core\web\fn_warmBridge.sqf.
	//
	// THE onLoad IS NOT DECORATION. A title layer is not findDisplay-able (see
	// dialog\hudWeb.hpp's header for the same note against AP_web_hud), so parking
	// the display in uiNamespace is the ONLY way fn_warmBridge can reach control
	// 930451 to wire the progress channel onto it. onUnload clears the slot so a
	// re-cut does not hand out a dead handle.
	class AP_map_warm {
		idd = 930450;
		duration = 1e10;
		fadeIn = 0; fadeOut = 0;
		onLoad = "uiNamespace setVariable ['AP_map_warm', _this select 0];";
		onUnload = "uiNamespace setVariable ['AP_map_warm', displayNull];";
		class controls {
			class Warm {
				idc = 930451;
				type = 106;
				style = 0;
				x = safezoneX; y = safezoneY;
				w = 0.02; h = 0.02;   // present but a speck; the page draws nothing
				colorBackground[] = {0,0,0,0};
				colorText[] = {1,1,1,1};
				font = "RobotoCondensed";
				sizeEx = 0.02;
				url = "ui\html\warm.html";
			};
		};
	};
