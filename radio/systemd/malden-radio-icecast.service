[Unit]
Description=Malden Radio - Icecast
After=network.target

[Service]
User=icecast
ExecStart=/usr/bin/icecast -c /etc/malden-radio/icecast.xml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/icecast

[Install]
WantedBy=multi-user.target
