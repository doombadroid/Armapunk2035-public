{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Armapunk Launcher",
  "version": "0.1.0",
  "identifier": "com.armapunk.launcher",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
